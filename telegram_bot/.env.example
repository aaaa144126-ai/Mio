# توكن البوت اللي هتاخده من @BotFather على تليجرام
BOT_TOKEN=123456789:AAExampleTokenGoesHere

# آي دي حسابك على تليجرام (وأي أدمنز تانيين)، مفصولين بفاصلة
# ابعت رسالة لـ @userinfobot عشان تعرف آي ديك
ADMIN_IDS=123456789

# رابط السيرفر بعد النشر (من غير / في الآخر)
# مثال: https://nursing-bot.onrender.com
BASE_URL=

# باسورد دخول لوحة تحكم الأدمن على الموقع
ADMIN_PASSWORD=changeme

# مفتاح سري عشوائي لجلسات الموقع
SECRET_KEY=change-this-to-a-random-string

# اسم يظهر في واجهة البوت والموقع
BOT_TITLE=بوت الفرقة التالتة - تمريض

# رابط قاعدة البيانات (سيبها كده للتشغيل المحلي)
DATABASE_URL=sqlite:///nursing_bot.db
